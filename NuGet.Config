<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The app has no direct PackageReference dependencies; self-contained publish restores Microsoft runtime packs. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
