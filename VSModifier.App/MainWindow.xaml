<Window x:Class="VSModifier.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:saves="clr-namespace:VSModifier.Core.Saves;assembly=VSModifier.Core"
        Title="VSModifier - Vampire Survivors 修改器"
        Width="1180" Height="800" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type saves:JsonTreeEntry}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" ToolTip="{Binding Path}" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VSModifier" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="存檔修改器與單機外部 Trainer。不修改遊戲檔案。"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReloadButton" Content="重新載入" Click="ReloadButton_Click" IsEnabled="False" />
                    <Button x:Name="SaveButton" Content="備份並寫入" Click="SaveButton_Click" IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,10" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="GameStatusLight" Width="10" Height="10" Fill="{StaticResource TextDisabledBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="GameStatusText" Grid.Column="1" Text="檢查遊戲狀態…" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="StatusText" Grid.Column="2" Text="準備中…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CurrentSavePathStatusText" Grid.Column="3" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           MaxWidth="260" TextTrimming="CharacterEllipsis" Margin="12,0" />
                <TextBlock x:Name="BackupStatusText" Grid.Column="4" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="最近備份：尚無" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Margin="16" IsEnabled="False">
            <TabItem Header="存檔">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="存檔安全" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="選擇 SaveData，檢查完整性，並在寫入前保留可復原的完整備份。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <GroupBox Header="存檔位置">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SavePathTextBox" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="自動尋找" Click="DetectSaveButton_Click" />
                                <Button Grid.Column="2" Content="瀏覽…" Click="BrowseSaveButton_Click" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="檔案狀態">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Checksum" Style="{StaticResource FieldLabelStyle}" Margin="0,5" />
                                <TextBlock x:Name="ChecksumText" Grid.Column="1" Margin="0,5" />
                                <TextBlock Grid.Row="1" Text="原始檔案大小" Style="{StaticResource FieldLabelStyle}" Margin="0,5" />
                                <TextBlock x:Name="SaveSizeText" Grid.Row="1" Grid.Column="1" Margin="0,5" />
                                <TextBlock Grid.Row="2" Text="備份位置" Style="{StaticResource FieldLabelStyle}" Margin="0,5" />
                                <TextBlock x:Name="BackupPathText" Grid.Row="2" Grid.Column="1" Margin="0,5" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>
                        <TextBlock Margin="4,2,4,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                   Text="安全流程：Steam 可以保持開啟，但遊戲必須關閉。每次寫入前都會建立完整備份；遊戲執行中會強制拒絕寫入。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="資源">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="資源數值" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="編輯常用資源。所有變更先保留在記憶體，直到按下「備份並寫入」。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <GroupBox Header="資源數值">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Coins" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="CoinsTextBox" Grid.Column="1" />
                                <TextBlock Grid.Column="2" Text="LifetimeCoins" Style="{StaticResource FieldLabelStyle}" Margin="18,0,10,0" />
                                <TextBox x:Name="LifetimeCoinsTextBox" Grid.Column="3" />
                                <TextBlock Grid.Row="1" Text="TotalCoins" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TotalCoinsTextBox" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Seals" Style="{StaticResource FieldLabelStyle}" Margin="18,0,10,0" />
                                <TextBox x:Name="SealsTextBox" Grid.Row="1" Grid.Column="3" />
                                <TextBlock Grid.Row="2" Text="AdventureStars" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="AdventureStarsTextBox" Grid.Row="2" Grid.Column="1" />
                            </Grid>
                        </GroupBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="套用欄位" Click="ApplyResourcesButton_Click" />
                            <Button Content="一鍵最大化…" Click="MaximizeButton_Click" Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="解鎖">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="解鎖資料" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="編輯所選陣列的 ID 清單，或安全合併目前版本的解鎖目錄。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="欄位" VerticalAlignment="Center" Margin="4" />
                        <ComboBox x:Name="UnlockPropertyComboBox" Width="290" SelectionChanged="UnlockPropertyComboBox_SelectionChanged">
                            <ComboBoxItem Content="BoughtCharacters" />
                            <ComboBoxItem Content="UnlockedCharacters" />
                            <ComboBoxItem Content="UnlockedWeapons" />
                            <ComboBoxItem Content="CollectedWeapons" />
                            <ComboBoxItem Content="BoughtPowerups" />
                            <ComboBoxItem Content="UnlockedPowerUpRanks" />
                            <ComboBoxItem Content="CollectedItems" />
                            <ComboBoxItem Content="UnlockedStages" />
                            <ComboBoxItem Content="UnlockedHypers" />
                            <ComboBoxItem Content="UnlockedArcanas" />
                            <ComboBoxItem Content="Achievements" />
                            <ComboBoxItem Content="Secrets" />
                            <ComboBoxItem Content="BoughtSkins" />
                            <ComboBoxItem Content="OpenedCoffins" />
                        </ComboBox>
                        <TextBlock Text="每行一個 ID；皮膚 dictionary 請用進階 JSON" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0" />
                    </StackPanel>
                    <TextBox x:Name="UnlockIdsTextBox" Grid.Row="2" Margin="4,10" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="一鍵套用版本解鎖表…" Click="UnlockAllButton_Click" Style="{StaticResource DangerButtonStyle}" />
                        <Button Content="套用 ID 清單" Click="ApplyUnlocksButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="蛋">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="金蛋屬性" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="一次調整一名角色的一項金蛋加成，其他屬性保持原值。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <GroupBox Header="EggData 單項編輯">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="角色 ID" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EggCharacterTextBox" Grid.Column="1" ToolTip="例如 ANTONIO"
                                         TextChanged="EggCharacterTextBox_TextChanged" />
                                <TextBlock Grid.Row="1" Text="屬性" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="EggAttributeComboBox" Grid.Row="1" Grid.Column="1"
                                          SelectionChanged="EggAttributeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="攻擊力（power）" Tag="power" />
                                    <ComboBoxItem Content="經驗成長（growth）" Tag="growth" />
                                    <ComboBoxItem Content="金幣獲得（greed）" Tag="greed" />
                                    <ComboBoxItem Content="幸運（luck）" Tag="luck" />
                                    <ComboBoxItem Content="冷卻（cooldown）" Tag="cooldown" />
                                    <ComboBoxItem Content="移動速度（moveSpeed）" Tag="moveSpeed" />
                                    <ComboBoxItem Content="攻擊範圍（area）" Tag="area" />
                                    <ComboBoxItem Content="投射物數量（amount）" Tag="amount" />
                                    <ComboBoxItem Content="持續時間（duration）" Tag="duration" />
                                    <ComboBoxItem Content="投射物速度（speed）" Tag="speed" />
                                    <ComboBoxItem Content="護甲／防禦（armor）" Tag="armor" />
                                    <ComboBoxItem Content="生命回復（regen）" Tag="regen" />
                                    <ComboBoxItem Content="磁吸範圍（magnet）" Tag="magnet" />
                                    <ComboBoxItem Content="最大生命（maxHp）" Tag="maxHp" />
                                    <ComboBoxItem Content="詛咒（curse）" Tag="curse" />
                                    <ComboBoxItem Content="復活次數（revivals）" Tag="revivals" />
                                    <ComboBoxItem Content="重抽次數（rerolls）" Tag="rerolls" />
                                    <ComboBoxItem Content="跳過次數（skips）" Tag="skips" />
                                    <ComboBoxItem Content="放逐次數（banish）" Tag="banish" />
                                    <ComboBoxItem Content="魅惑（charm）" Tag="charm" />
                                    <ComboBoxItem Content="拔牙（defang）" Tag="defang" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="目前此屬性" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="EggCurrentValueText" Grid.Row="2" Grid.Column="1"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6" />
                                <TextBlock Grid.Row="3" Text="金蛋數（設為）" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EggValueTextBox" Grid.Row="3" Grid.Column="1" />
                            </Grid>
                        </GroupBox>
                        <TextBlock Margin="4,2" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="一次只修改所選屬性；其他金蛋加成保持原值，並重新計算該角色的 total。尚未寫入磁碟，必須再按右上角「備份並寫入」。" />
                        <Button Content="只套用此金蛋屬性" HorizontalAlignment="Right" Click="ApplyEggButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="旗標">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="進度旗標" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="檢視並調整常用布林旗標。批次進度操作會先要求確認。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <GroupBox Header="常用旗標">
                            <StackPanel>
                                <CheckBox x:Name="QuickTreasureCheckBox" Content="AlwaysQuickTreasureAnim - 永久快速寶箱動畫" />
                                <CheckBox x:Name="CheatCodeUsedCheckBox" Content="CheatCodeUsed - 遊戲作弊碼使用標記" />
                                <CheckBox x:Name="FinalBossCheckBox" Content="HasKilledTheFinalBoss - 已擊敗最終 Boss" />
                                <CheckBox x:Name="SequentialChestCheckBox" Content="SequentialChestMode - 連續寶箱模式" />
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="套用旗標" Click="ApplyFlagsButton_Click" />
                            <Button Content="所有 HasSeen / HasUsed 設為 true…" Click="SetProgressFlagsButton_Click" Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="進階 JSON">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="進階 JSON" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="使用樹狀檢視定位欄位，或直接編輯完整 JSON。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="可修改任何未提供專屬介面的欄位。套用時會驗證型別或 JSON；寫入時會重算 checksum。"
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="4,0,4,14" />
                    <TabControl Grid.Row="2">
                        <TabItem Header="樹狀">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TreeView x:Name="JsonTreeView" SelectedItemChanged="JsonTreeView_SelectedItemChanged" />
                                <GroupBox Grid.Column="1" Header="選取節點" Margin="10,0,0,0">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="JsonSelectedPathTextBox" IsReadOnly="True" ToolTip="JSON 路徑" />
                                        <TextBlock x:Name="JsonSelectedTypeText" Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}" Margin="6" />
                                        <TextBox x:Name="JsonSelectedValueTextBox" Grid.Row="2" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" IsEnabled="False" />
                                        <Button x:Name="ApplySelectedJsonValueButton" Grid.Row="3" Content="套用選取值"
                                                HorizontalAlignment="Right" IsEnabled="False" Click="ApplySelectedJsonValueButton_Click" />
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="原始 JSON">
                            <TextBox x:Name="JsonEditorTextBox" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                        </TabItem>
                    </TabControl>
                    <Button Grid.Row="3" Content="驗證並套用原始 JSON" HorizontalAlignment="Right" Click="ApplyJsonButton_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="Trainer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="外部記憶體 Trainer" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="僅在已辨識、已驗證的離線單人版本中附加；安全條件失效時自動中斷並還原。"
                                   Style="{StaticResource PageDescriptionStyle}" />
                        <GroupBox Header="版本與連線狀態">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="遊戲安裝" Style="{StaticResource FieldLabelStyle}" Margin="0,5" />
                                <TextBlock x:Name="TrainerGamePathText" Grid.Column="1" Margin="0,5" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="版本 Profile" Style="{StaticResource FieldLabelStyle}" Margin="0,5" />
                                <TextBlock x:Name="TrainerVersionText" Grid.Row="1" Grid.Column="1" Margin="0,5" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="Trainer 狀態" Style="{StaticResource FieldLabelStyle}" Margin="0,5" />
                                <TextBlock x:Name="TrainerStatusText" Grid.Row="2" Grid.Column="1" Margin="0,5" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="2" Grid.RowSpan="3" Orientation="Vertical" VerticalAlignment="Center">
                                    <Button x:Name="RefreshTrainerProfileButton" Content="重新偵測版本"
                                            Click="RefreshTrainerProfileButton_Click" />
                                    <Button x:Name="AttachTrainerButton" Content="附加遊戲" Click="AttachTrainerButton_Click" IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button x:Name="DetachTrainerButton" Content="中斷並還原" Click="DetachTrainerButton_Click" IsEnabled="False"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <Border Margin="0,0,0,14" Padding="16" CornerRadius="10" Background="#33291A"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" Foreground="#F5D894"
                                       Text="僅限單機／本地遊玩。缺少已驗證版本、功能偏移或線上會話防護時，程式會拒絕附加。遊戲關閉或中斷 Trainer 時會嘗試還原所有原始值。" />
                        </Border>
                        <GroupBox Header="全域熱鍵">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="EnableHotkeysCheckBox" Content="啟用全域熱鍵（預設停用）"
                                          Click="EnableHotkeysCheckBox_Click" />
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Ctrl+Shift+F1 無敵｜Ctrl+Shift+F2 快速寶箱｜Ctrl+Shift+F3 最高寶箱｜Ctrl+Shift+F4 傷害倍率｜Ctrl+Shift+F5 遊戲速率｜Ctrl+Shift+F12 緊急中斷並還原。功能熱鍵只有在 Trainer 已安全附加時才會執行。" />
                            </StackPanel>
                        </GroupBox>
                        <StackPanel x:Name="TrainerControlsPanel" IsEnabled="False">
                            <GroupBox Header="主要功能">
                                <StackPanel>
                                    <CheckBox x:Name="InvulnerabilityCheckBox" Content="無敵（永久 invulnerability）"
                                              Tag="invulnerability" Click="TrainerDirectValueCheckBox_Click" />
                                    <CheckBox x:Name="QuickTreasureRuntimeCheckBox" Content="即時快速寶箱動畫"
                                              Tag="quickTreasure" Click="TrainerDirectValueCheckBox_Click" />
                                    <CheckBox x:Name="MaxTreasureCheckBox" Content="寶箱強制最高獎勵（code patch）"
                                              Tag="maxTreasure" Click="TrainerPatchCheckBox_Click" />
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="DamageMultiplierCheckBox" Content="傷害倍率" Tag="damageMultiplier"
                                                  Click="TrainerMultiplierCheckBox_Click" />
                                        <TextBox x:Name="DamageMultiplierTextBox" Grid.Column="1" Text="10" />
                                        <TextBlock Grid.Column="2" Text="× 原始值" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="GameSpeedCheckBox" Content="遊戲速率" Tag="gameSpeed"
                                                  Click="TrainerMultiplierCheckBox_Click" />
                                        <TextBox x:Name="GameSpeedTextBox" Grid.Column="1" Text="2" />
                                        <TextBlock Grid.Column="2" Text="× 原始值；暫停值 0 不覆寫" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="PlayerModifierStats 倍率">
                                <StackPanel>
                                    <TextBlock Text="勾選後以 100ms 間隔維持調整值；倍率項使用原始值 × 輸入值，標示「+」者使用原始值 + 輸入值。取消勾選會還原原始值。"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8" />
                                    <UniformGrid x:Name="TrainerAttributePanel" Columns="2" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="即時數值（單次讀寫）">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="本局金幣" VerticalAlignment="Center" />
                                    <TextBox x:Name="RuntimeCoinsTextBox" Grid.Column="1" Text="0" />
                                    <Button x:Name="ReadRuntimeCoinsButton" Grid.Column="2" Content="讀取" Tag="coins"
                                            Click="TrainerNumericReadButton_Click" />
                                    <Button x:Name="WriteRuntimeCoinsButton" Grid.Column="3" Content="設定" Tag="coins"
                                            Click="TrainerNumericWriteButton_Click" />
                                    <TextBlock Grid.Column="4" Text="0-999,999,999" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Text="角色等級" VerticalAlignment="Center" />
                                    <TextBox x:Name="RuntimeLevelTextBox" Grid.Row="1" Grid.Column="1" Text="1" />
                                    <Button x:Name="ReadRuntimeLevelButton" Grid.Row="1" Grid.Column="2" Content="讀取" Tag="level"
                                            Click="TrainerNumericReadButton_Click" />
                                    <Button x:Name="WriteRuntimeLevelButton" Grid.Row="1" Grid.Column="3" Content="設定" Tag="level"
                                            Click="TrainerNumericWriteButton_Click" />
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="1-10,000" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Text="目前經驗值" VerticalAlignment="Center" />
                                    <TextBox x:Name="RuntimeExperienceTextBox" Grid.Row="2" Grid.Column="1" Text="0" />
                                    <Button x:Name="ReadRuntimeExperienceButton" Grid.Row="2" Grid.Column="2" Content="讀取" Tag="experience"
                                            Click="TrainerNumericReadButton_Click" />
                                    <Button x:Name="WriteRuntimeExperienceButton" Grid.Row="2" Grid.Column="3" Content="設定" Tag="experience"
                                            Click="TrainerNumericWriteButton_Click" />
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="0-999,999,999" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="升級與重複裝備">
                                <StackPanel Margin="8">
                                    <TextBlock Text="強制升級選項只改寫下一次升級頁面候選；重複按鈕只解除下一次新增裝備的重複檢查。所有 hook 會在中斷時還原。"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="4" />
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ForceLevelUpItemCheckBox" Content="強制下一次升級候選"
                                                  Click="ForceLevelUpItemCheckBox_Click" />
                                        <ComboBox x:Name="ForceLevelUpItemComboBox" Grid.Column="1"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="ForceLevelUpItemComboBox_SelectionChanged" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <Button x:Name="DuplicateNextWeaponButton" Content="允許下一把重複武器"
                                                Tag="duplicateNextWeapon" Click="DuplicateNextButton_Click" />
                                        <Button x:Name="DuplicateNextAccessoryButton" Content="允許下一個重複配件"
                                                Tag="duplicateNextAccessory" Click="DuplicateNextButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
